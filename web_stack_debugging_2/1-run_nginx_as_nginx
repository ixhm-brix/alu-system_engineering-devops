#!/usr/bin/env bash
# Configure nginx to run as the nginx user and listen on port 8080 of all IPs
useradd nginx 2>/dev/null
sed -i 's/listen 80\b/listen 8080/' /etc/nginx/sites-enabled/default
sed -i 's/\]:80\b/]:8080/' /etc/nginx/sites-enabled/default
sed -i 's/user www-data;/user nginx;/' /etc/nginx/nginx.conf
sed -i 's|pid .*;|pid /tmp/nginx.pid;|' /etc/nginx/nginx.conf
mkdir -p /var/log/nginx /var/lib/nginx
chown -R nginx:nginx /var/log/nginx /var/lib/nginx
pkill nginx 2>/dev/null
sleep 1
sudo -u nginx /usr/sbin/nginx
